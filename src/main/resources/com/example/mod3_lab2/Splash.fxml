<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="700.0" maxWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mod3_lab2.SplashController">
   <children>
      <ImageView fitHeight="704.0" fitWidth="701.0" pickOnBounds="true">
         <image>
            <Image url="@images/Moto3.jpg" />
         </image>
      </ImageView>
      <VBox fx:id="root" alignment="CENTER" prefHeight="500" prefWidth="400" spacing="20" stylesheets="@Style.css">
          <Label styleClass="title" text="Moto Madness" textFill="#79ff6a99">
            <font>
               <Font name="Eras Demi ITC" size="30.0" />
            </font>
         </Label>
          <ProgressIndicator />
          <Label styleClass="subtitle" text="Loading..." textFill="#15ff29" />
      </VBox>
   </children>
</StackPane>
